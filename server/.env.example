PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Local dev: http://localhost:5173
# Production (Phase 5): your deployed Vercel URL, e.g. https://your-app.vercel.app
# Can be a comma-separated list to allow both at once during testing:
# CLIENT_ORIGIN=https://your-app.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" when deploying (Render) — this switches the admin
# session cookie to sameSite:none + secure:true, required for cross-domain
# auth once client and server live on different domains. Leave unset locally.
NODE_ENV=

# Auth (Phase 3) — direct plaintext comparison, deliberately not hashed.
# This guards ONE person's own admin panel, in an env file that already
# holds equally sensitive values (MONGODB_URI, JWT_SECRET) — hashing adds
# no real protection here and introduces a genuine failure mode: bcrypt
# hashes contain '$' characters (e.g. $2a$10$...), which get silently
# mangled if this file is ever loaded via a shell `export`/`source`
# instead of the dotenv package — `$2a` and `$10` get read as shell
# variable references and quietly strip to nothing. That's a real,
# reproduced cause of "my password is wrong" even with correct credentials,
# not a hypothetical. Plaintext side-steps it, at the cost of the password
# being readable if this file ever leaks — same exposure your MongoDB URI
# and JWT secret already have.
#
# JWT_SECRET is also reused by the regular user-account system (Tier 1
# feature: sign up / sign in, synced progress + saved items) — admin and
# user tokens carry a "type" claim and live in separate cookies (token vs
# user_token), so one secret safely signs both without either being able
# to impersonate the other. No separate env var needed for accounts.
JWT_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=you@example.com
# Avoid '$' or other shell-special characters here too, in case you ever
# load this file via a shell source instead of dotenv — same failure mode
# as above, just applied to the password itself instead of a hash of it.
ADMIN_PASSWORD=choose_a_password_here

# File storage (Phase 3) — free Supabase project: https://supabase.com/dashboard
# Create a public Storage bucket, then paste its details below.
# Leave blank and the admin panel's "Paste URL" mode still works without this.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resource-hub-files

# Ask AI (Phase 7) — optional, and free. Get a key at https://console.groq.com
# (sign in, "API Keys" in the sidebar, create one — starts with "gsk_").
# Leave GROQ_API_KEY blank and the feature disables itself cleanly (the
# endpoint returns a clear "not configured" message instead of failing).
GROQ_API_KEY=
# Defaults to llama-3.3-70b-versatile if unset — override to point at
# whichever current model you want; check https://console.groq.com for the
# current lineup (Groq's free-tier model set changes over time).
GROQ_MODEL=
